# ==============================================================================
# DOCUMENT CONTRACT AND PUBLIC-ONTOLOGY FENCE
# ==============================================================================

# No private namespace is declared or used.
# Every enterprise-specific resource is a Turtle blank node (_:...).
# All classes and predicates come from public RDF vocabularies listed above.
# skos:notation supplies deterministic human-operable handles without minting IRIs.

_:dataset
    rdf:type dcat:Dataset , prov:Entity ;
    rdfs:label "Fortune 5 Public-Ontology Cloud Architecture"@en ;
    skos:notation "F5-CLOUD-ARCH-2026-07" ;
    dcterms:description "A hyperscale, multi-cloud, hybrid enterprise architecture reference graph covering business motivation, organization, capabilities, value streams, applications, data, technology, landing zones, security controls, policies, observability, resilience, FinOps, delivery provenance, receipts, and machine-checkable SHACL constraints."@en ;
    dcterms:issued "2026-07-13"^^xsd:date ;
    dcterms:modified "2026-07-13"^^xsd:date ;
    dcterms:language "en" ;
    dcterms:format "text/turtle" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:conformsTo <http://www.w3.org/TR/turtle/> , <http://www.w3.org/TR/shacl/> , <http://www.semanticweb.org/ontologies/2020/4/OntologyTOGAFContentMetamodel.owl> ;
    schema:version "2026.07" ;
    prov:wasGeneratedBy _:manufacture_activity .

_:manufacture_activity
    rdf:type prov:Activity ;
    rdfs:label "Architecture graph manufacture"@en ;
    skos:notation "ACT-MANUFACTURE-001" ;
    dcterms:description "Deterministic manufacture of the public-ontology architecture artifact."@en ;
    prov:startedAtTime "2026-07-13T17:00:00Z"^^xsd:dateTime ;
    prov:endedAtTime "2026-07-13T17:00:01Z"^^xsd:dateTime ;
    prov:wasAssociatedWith _:architecture_manufacturing_agent ;
    prov:generated _:dataset , _:manufacture_receipt .

_:architecture_manufacturing_agent
    rdf:type prov:SoftwareAgent , schema:SoftwareApplication ;
    rdfs:label "Deterministic architecture graph generator"@en ;
    skos:notation "AGENT-GRAPH-MANUFACTURER" ;
    schema:applicationCategory "Architecture knowledge graph manufacture" .

_:manufacture_receipt
    rdf:type prov:Entity , dcat:Resource ;
    rdfs:label "Architecture manufacture receipt"@en ;
    skos:notation "RECEIPT-MANUFACTURE-001" ;
    dcterms:description "Receipt proving that the graph manufacture activity generated this dataset."@en ;
    dcterms:identifier "9fb0bcda4477b520a79ec2bd6547b014cf8fbec7afc9d2e72609dccf4ea6451a" ;
    prov:wasGeneratedBy _:manufacture_activity .

