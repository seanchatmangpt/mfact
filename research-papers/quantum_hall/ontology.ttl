@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ggen: <https://praxis.chatman.com/ontology/ggen#> .
@prefix wf: <https://praxis.chatman.com/ontology/workflow#> .

wf:PhaseTransitionState a ggen:OntologyObject ;
    ggen:isMathematicallyAdmitted "true" ;
    ggen:leanProofTarget "QuantumHall.PhaseTransitionState" .

wf:NonAbelianAcquittal a ggen:Theorem ;
    ggen:isMathematicallyAdmitted "true" ;
    ggen:leanProofTarget "QuantumHall.non_abelian_acquittal_of_parabolic_law" ;
    ggen:computationalConsequence "NON_ABELIAN_RESOURCE_PREDICTION" ;
    ggen:projectionTarget "PHASE_TRANSITION_ANOMALY_DETECTOR" .
