@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ggen: <https://praxis.chatman.com/ontology/ggen#> .
@prefix wf: <https://praxis.chatman.com/ontology/workflow#> .

wf:DynamicSystem a ggen:OntologyObject ;
    ggen:isMathematicallyAdmitted "true" ;
    ggen:leanProofTarget "PairCorrelation.DynamicSystem" .

wf:MixingOrbitsIID a ggen:Theorem ;
    ggen:isMathematicallyAdmitted "true" ;
    ggen:leanProofTarget "PairCorrelation.mixing_orbits_asymptotic_iid" ;
    ggen:computationalConsequence "STOCHASTIC_LOAD_PREDICTION" ;
    ggen:projectionTarget "IID_CACHE_PREDICTOR" .
