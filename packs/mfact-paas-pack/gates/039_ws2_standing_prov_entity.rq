# MESSAGE: StandingRecord must remain a PROV Entity
PREFIX mfp: <https://mfact.dev/paas#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?violation WHERE { BIND("standing_is_prov_entity" AS ?violation) FILTER NOT EXISTS { mfp:StandingRecord rdfs:subClassOf prov:Entity . } }
