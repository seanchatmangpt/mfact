# MESSAGE: standing records must derive from an execution receipt
PREFIX mfp: <https://mfact.dev/paas#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
SELECT ?shape WHERE {
  BIND(mfp:StandingRecordShape AS ?shape)
  FILTER NOT EXISTS { ?shape sh:property [ sh:path mfp:standingReceipt ; sh:class mfp:Receipt ] }
}
