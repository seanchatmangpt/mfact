# MESSAGE: capturedAt must preserve PROV generated-at semantics
PREFIX mfp: <https://mfact.dev/paas#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?v WHERE { BIND("captured_at_contract" AS ?v) FILTER NOT EXISTS { mfp:capturedAt rdfs:subPropertyOf prov:generatedAtTime ; rdfs:domain mfp:StandingRecord ; rdfs:range xsd:dateTime . } }
