# MESSAGE: StandingRecord must remain a DCAT Dataset
PREFIX mfp: <https://mfact.dev/paas#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?violation WHERE { BIND("standing_is_dcat_dataset" AS ?violation) FILTER NOT EXISTS { mfp:StandingRecord rdfs:subClassOf dcat:Dataset . } }
