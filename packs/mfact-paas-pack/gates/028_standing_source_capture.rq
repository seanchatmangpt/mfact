# MESSAGE: standing records require source path and capture timestamp
PREFIX mfp: <https://mfact.dev/paas#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
SELECT ?shape WHERE {
  { BIND(mfp:StandingRecordShape AS ?shape) FILTER NOT EXISTS { ?shape sh:property [ sh:path mfp:sourcePath ] } }
  UNION
  { BIND(mfp:StandingRecordShape AS ?shape) FILTER NOT EXISTS { ?shape sh:property [ sh:path mfp:capturedAt ] } }
}
