# MESSAGE: certifiedRelease must remain a standing type value
PREFIX mfp: <https://mfact.dev/paas#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?v WHERE { BIND("certified_release_contract" AS ?v) FILTER NOT EXISTS { mfp:certifiedRelease rdfs:subPropertyOf dcterms:type ; rdfs:domain mfp:StandingRecord ; rdfs:range xsd:string . } }
