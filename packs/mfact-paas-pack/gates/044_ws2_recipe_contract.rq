# MESSAGE: recipe must remain a typed request discriminator
PREFIX mfp: <https://mfact.dev/paas#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?v WHERE { BIND("recipe_contract" AS ?v) FILTER NOT EXISTS { mfp:recipe rdfs:subPropertyOf dcterms:type ; rdfs:domain mfp:CertificationRequest ; rdfs:range xsd:string . } }
