---
to: "paas/lib/mfact_paas/generated/resources.ex"
sparql:
  resources: |
    PREFIX mfp: <https://mfact.dev/paas#>
    PREFIX sh: <http://www.w3.org/ns/shacl#>
    SELECT ?shapeId ?ashModule ?table ?classIri ?subjectTemplate
    WHERE {
      ?shape a sh:NodeShape ;
        mfp:shapeId ?shapeId ;
        mfp:ashModule ?ashModule ;
        mfp:table ?table ;
        mfp:classIri ?classIri ;
        mfp:subjectTemplate ?subjectTemplate .
    }
    ORDER BY ?shapeId
  attributes: |
    PREFIX mfp: <https://mfact.dev/paas#>
    PREFIX sh: <http://www.w3.org/ns/shacl#>
    SELECT ?ownerId ?ashName ?ashType ?predicateIri ?allowNil
    WHERE {
      ?shape a sh:NodeShape ;
        mfp:shapeId ?ownerId ;
        sh:property ?property .
      ?property mfp:kind "attribute" ;
        mfp:ashName ?ashName ;
        mfp:ashType ?ashType ;
        mfp:predicateIri ?predicateIri ;
        mfp:allowNil ?allowNil .
    }
    ORDER BY ?ownerId ?ashName
  relationships: |
    PREFIX mfp: <https://mfact.dev/paas#>
    PREFIX sh: <http://www.w3.org/ns/shacl#>
    SELECT ?ownerId ?ashName ?targetModule ?predicateIri ?allowNil
    WHERE {
      ?shape a sh:NodeShape ;
        mfp:shapeId ?ownerId ;
        sh:property ?property .
      ?property mfp:kind "relationship" ;
        mfp:ashName ?ashName ;
        mfp:targetModule ?targetModule ;
        mfp:predicateIri ?predicateIri ;
        mfp:allowNil ?allowNil .
    }
    ORDER BY ?ownerId ?ashName
force: true
skip_empty: false
---
# GENERATED by ggen from packs/mfact-paas-pack/ontology.ttl.
# Semantic authority lives in RDF/SHACL. Do not hand-edit this file.

{% for resource in resources %}
defmodule {{ resource.ashModule }} do
  @moduledoc false

  use Ash.Resource,
    domain: MfactPaaS.Domain,
    data_layer: AshPostgres.DataLayer,
    extensions: [AshR2RML.Resource]

  postgres do
    table "{{ resource.table }}"
    repo MfactPaaS.Repo
  end

  r2rml do
    table_name "{{ resource.table }}"
    class "{{ resource.classIri }}"

    subject do
      template "{{ resource.subjectTemplate }}"
      term_type :iri
    end
{% for attribute in attributes %}{% if attribute.ownerId == resource.shapeId %}
    property :{{ attribute.ashName }}, "{{ attribute.predicateIri }}"
{% endif %}{% endfor %}{% for relationship in relationships %}{% if relationship.ownerId == resource.shapeId %}
    reference :{{ relationship.ashName }}, "{{ relationship.predicateIri }}"
{% endif %}{% endfor %}
  end

  actions do
    default_accept :*
    defaults [:read, :create, :update, :destroy]
  end

  attributes do
    uuid_primary_key :id
{% for attribute in attributes %}{% if attribute.ownerId == resource.shapeId %}
    attribute :{{ attribute.ashName }}, :{{ attribute.ashType }} do
      allow_nil? {{ attribute.allowNil }}
      public? true
    end
{% endif %}{% endfor %}
  end

  relationships do
{% for relationship in relationships %}{% if relationship.ownerId == resource.shapeId %}
    belongs_to :{{ relationship.ashName }}, {{ relationship.targetModule }} do
      allow_nil? {{ relationship.allowNil }}
      public? true
      attribute_public? true
      attribute_writable? true
    end
{% endif %}{% endfor %}
  end
end

{% endfor %}
defmodule MfactPaaS.Generated.Resources do
  @moduledoc false

  @resources [
{% for resource in resources %}
    {{ resource.ashModule }},
{% endfor %}
  ]

  def all, do: @resources
end
