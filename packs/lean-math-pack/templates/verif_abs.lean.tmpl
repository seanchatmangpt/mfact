---
to: "dist/verif/lean/Wasm4pmVerify/Abs.lean"
sparql:
  obligation: |
    PREFIX verif: <https://mfact.dev/verif#>
    SELECT ?proofPattern ?carrierName ?leanDecl
    WHERE {
      ?o a verif:CorrespondenceObligation ;
         verif:proofPattern ?proofPattern ;
         verif:carrierName ?carrierName ;
         verif:leanDecl ?leanDecl .
    }
    ORDER BY ?carrierName
    LIMIT 1
force: true
skip_empty: true
---
-- RENDERED by `ggen sync` from the mfact verification catalog.
-- Do not edit by hand.
import ProcInt.Conformance.TokenReplay
import Wasm4pmVerify.Kernel
import Wasm4pmVerify.Generated.Wasm4pmCore

namespace Wasm4pmVerify

{% if proofPattern == "ReplayCountsExactFitness" %}
def {{ carrierName }} :
    Carrier Generated.ReplayCounts ProcInt.ReplayCounts where
  WF counts :=
    counts.missing ≤ counts.consumed ∧
      counts.remaining ≤ counts.produced
  toSpec counts h :=
    { produced := counts.produced
      consumed := counts.consumed
      missing := counts.missing
      remaining := counts.remaining
      missing_le := h.1
      remaining_le := h.2 }
{% else %}
#error "UNSUPPORTED_CARRIER_PATTERN"
{% endif %}

end Wasm4pmVerify
