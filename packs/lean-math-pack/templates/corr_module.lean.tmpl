---
to: "dist/verif/lean/Wasm4pmVerify/Corr/TokenReplayCounts.lean"
sparql:
  obligation: |
    PREFIX verif: <https://mfact.dev/verif#>
    SELECT ?corrName ?rustSymbol ?rustFile ?leanDecl ?proofPattern ?carrierName
           ?implementationFunction ?sourceCommit
    WHERE {
      ?o a verif:CorrespondenceObligation ;
         verif:corrName ?corrName ;
         verif:rustSymbol ?rustSymbol ;
         verif:rustFile ?rustFile ;
         verif:leanDecl ?leanDecl ;
         verif:proofPattern ?proofPattern ;
         verif:carrierName ?carrierName ;
         verif:implementationFunction ?implementationFunction ;
         verif:sourceCommit ?sourceCommit .
    }
    ORDER BY ?corrName
    LIMIT 1
force: true
skip_empty: true
---
{% for row in obligation %}
-- RENDERED by `ggen sync` from the mfact verification catalog.
-- Candidate Lean: admitted only by `lake build`. Do not edit by hand.
-- Rust target: {{ row.rustSymbol }}
-- Rust source: {{ row.rustFile }} @ {{ row.sourceCommit }}
-- Implementation function: {{ row.implementationFunction }}
-- Proof pattern: {{ row.proofPattern }}
import ProcInt.Conformance.TokenReplay
import Wasm4pmVerify.Abs

namespace Wasm4pmVerify.Corr

{% if row.proofPattern == "ReplayCountsExactFitness" %}
/-- The generated D1 implementation image and ProcInt use the same exact fitness law. -/
theorem {{ row.corrName }}
    (counts : Generated.ReplayCounts)
    (h : {{ row.carrierName }}.WF counts) :
    ProcInt.fitness ({{ row.carrierName }}.toSpec counts h) =
      Generated.fitness counts := by
  rfl

/-- The D1 image inherits ProcInt's unit-interval proof through the carrier map. -/
theorem token_replay_counts_bounds
    (counts : Generated.ReplayCounts)
    (h : {{ row.carrierName }}.WF counts) :
    0 ≤ Generated.fitness counts ∧ Generated.fitness counts ≤ 1 := by
  have hs := ProcInt.fitness_mem_unitInterval
    ({{ row.carrierName }}.toSpec counts h)
  simpa [{{ row.corrName }} counts h] using hs

/-- A replay with no missing or remaining tokens has exact fitness one. -/
theorem token_replay_counts_perfect
    (counts : Generated.ReplayCounts)
    (h : {{ row.carrierName }}.WF counts)
    (hm : counts.missing = 0)
    (hr : counts.remaining = 0) :
    Generated.fitness counts = 1 := by
  rw [← {{ row.corrName }} counts h]
  apply ProcInt.fitness_perfect
  · exact hm
  · exact hr
{% else %}
#error "UNSUPPORTED_CORRESPONDENCE_PATTERN"
{% endif %}

end Wasm4pmVerify.Corr
{% endfor %}
