# ---------- Module: Ocel.Core (order 50) ----------

procint:Mod_Ocel_Core a procint:Module ;
  procint:moduleId "Ocel.Core" ;
  procint:modPath "Ocel/Core" ;
  procint:order 50 ;
  procint:moduleDoc "Object-centric event logs, OCEL 2.0 (Berti, Koren, et al., arXiv 2403.01975, Def. 1-2): the OCEL structure with typed events and objects, discrete time, qualified E2O/O2O relations, time-stable event attributes and time-indexed object attributes, plus the derived object/event projections. Port of wasm4pm-compat src/ocel.rs (struct OCEL, OCEDO formal layer)." ;
  procint:importsBlock "import Mathlib" .

procint:Decl_OCEL a procint:Decl ;
  procint:inModule "Ocel.Core" ;
  procint:declOrder 1 ;
  procint:declName "ProcInt.OCEL" ;
  procint:declKind "structure" ;
  procint:status "definition" ;
  procint:leanCode """/-- Object-centric event log, OCEL 2.0 (arXiv 2403.01975, Def. 1-2). An OCEL over
event set E, object set O, event types ET, object types OT, qualifiers Q and
attribute values V carries: an event-type map, a discrete timestamp map, an
object-type map, qualified event-to-object and object-to-object relations, and
attribute valuations — event attributes are time-stable, object attributes are
time-indexed (oaval takes a timestamp). Port of wasm4pm-compat src/ocel.rs
struct OCEL (OCEDO formal layer L = (E, O, eval, oaval)). -/
structure OCEL (E O ET OT Q V : Type) where
  evtype : E → ET
  time : E → ℕ
  objtype : O → OT
  e2o : List (E × Q × O)
  o2o : List (O × Q × O)
  eaval : E → String → Option V
  oaval : O → String → ℕ → Option V""" .

procint:Decl_OCEL_objectsOf a procint:Decl ;
  procint:inModule "Ocel.Core" ;
  procint:declOrder 2 ;
  procint:declName "ProcInt.OCEL.objectsOf" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- Objects related to event e via the qualified E2O relation (OCEL 2.0 Def. 2;
wasm4pm-compat src/ocel.rs fn e2o, projected to the object component). -/
def OCEL.objectsOf {E O ET OT Q V : Type} [DecidableEq E]
    (L : OCEL E O ET OT Q V) (e : E) : List O :=
  (L.e2o.filter (fun t => decide (t.1 = e))).map (fun t => t.2.2)""" .

procint:Decl_OCEL_eventsOf a procint:Decl ;
  procint:inModule "Ocel.Core" ;
  procint:declOrder 3 ;
  procint:declName "ProcInt.OCEL.eventsOf" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- Events related to object o via the qualified E2O relation (OCEL 2.0 Def. 2;
the object-side projection dual to objectsOf). -/
def OCEL.eventsOf {E O ET OT Q V : Type} [DecidableEq O]
    (L : OCEL E O ET OT Q V) (o : O) : List E :=
  (L.e2o.filter (fun t => decide (t.2.2 = o))).map (fun t => t.1)""" .

procint:Decl_OCEL_objectsOf_length_le a procint:Decl ;
  procint:inModule "Ocel.Core" ;
  procint:declOrder 4 ;
  procint:declName "ProcInt.OCEL.objectsOf_length_le" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.OCEL.objectsOf_length_le' depends on axioms: [propext]" ;
  procint:leanCode """/-- The E2O projection of an event never exceeds the size of the raw qualified
relation table (filter-then-map length bound). -/
theorem OCEL.objectsOf_length_le {E O ET OT Q V : Type} [DecidableEq E]
    (L : OCEL E O ET OT Q V) (e : E) :
    (L.objectsOf e).length ≤ L.e2o.length := by
  simpa [OCEL.objectsOf] using List.length_filter_le _ L.e2o""" .

procint:Decl_OCEL_eventsOf_length_le a procint:Decl ;
  procint:inModule "Ocel.Core" ;
  procint:declOrder 5 ;
  procint:declName "ProcInt.OCEL.eventsOf_length_le" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.OCEL.eventsOf_length_le' depends on axioms: [propext]" ;
  procint:leanCode """/-- The dual bound for the object-side projection: eventsOf is a sublist-sized
selection of the qualified E2O relation table. -/
theorem OCEL.eventsOf_length_le {E O ET OT Q V : Type} [DecidableEq O]
    (L : OCEL E O ET OT Q V) (o : O) :
    (L.eventsOf o).length ≤ L.e2o.length := by
  simpa [OCEL.eventsOf] using List.length_filter_le _ L.e2o""" .

# ---------- Module: Ocel.Relations (order 51) ----------

procint:Mod_Ocel_Relations a procint:Module ;
  procint:moduleId "Ocel.Relations" ;
  procint:modPath "Ocel/Relations" ;
  procint:order 51 ;
  procint:moduleDoc "Qualified E2O/O2O relation projections and the object interaction graph over an OCEL 2.0 log (arXiv 2403.01975 Def. 2 and Sec. 3): two objects interact iff they share an event. Includes soundness of the projection (raw triples land in objectsOf) and symmetry of interaction. Port of wasm4pm-compat src/ocel.rs fns e2o/o2o." ;
  procint:importsBlock """import Mathlib
import ProcInt.Ocel.Core""" .

procint:Decl_OCEL_e2oProj a procint:Decl ;
  procint:inModule "Ocel.Relations" ;
  procint:declOrder 1 ;
  procint:declName "ProcInt.OCEL.e2oProj" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- Qualified E2O projection: the (qualifier, object) pairs attached to event e
(OCEL 2.0 Def. 2; wasm4pm-compat src/ocel.rs fn e2o returns exactly these
qualified pairs). -/
def OCEL.e2oProj {E O ET OT Q V : Type} [DecidableEq E]
    (L : OCEL E O ET OT Q V) (e : E) : List (Q × O) :=
  (L.e2o.filter (fun t => decide (t.1 = e))).map (fun t => t.2)""" .

procint:Decl_OCEL_o2oProj a procint:Decl ;
  procint:inModule "Ocel.Relations" ;
  procint:declOrder 2 ;
  procint:declName "ProcInt.OCEL.o2oProj" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- Qualified O2O projection: the (qualifier, target) pairs whose source is o
(OCEL 2.0 Def. 2; wasm4pm-compat src/ocel.rs fn o2o). -/
def OCEL.o2oProj {E O ET OT Q V : Type} [DecidableEq O]
    (L : OCEL E O ET OT Q V) (o : O) : List (Q × O) :=
  (L.o2o.filter (fun t => decide (t.1 = o))).map (fun t => t.2)""" .

procint:Decl_OCEL_Interacts a procint:Decl ;
  procint:inModule "Ocel.Relations" ;
  procint:declOrder 3 ;
  procint:declName "ProcInt.OCEL.Interacts" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- Object interaction graph edge: two objects interact iff they share an event
(standard object-interaction graph over an OCEL, cf. arXiv 2403.01975 Sec. 3). -/
def OCEL.Interacts {E O ET OT Q V : Type} [DecidableEq E]
    (L : OCEL E O ET OT Q V) (o₁ o₂ : O) : Prop :=
  ∃ e : E, o₁ ∈ L.objectsOf e ∧ o₂ ∈ L.objectsOf e""" .

procint:Decl_OCEL_interacts_symm a procint:Decl ;
  procint:inModule "Ocel.Relations" ;
  procint:declOrder 4 ;
  procint:declName "ProcInt.OCEL.interacts_symm" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.OCEL.interacts_symm' does not depend on any axioms" ;
  procint:leanCode """/-- The interaction relation is symmetric: sharing an event is order-agnostic. -/
theorem OCEL.interacts_symm {E O ET OT Q V : Type} [DecidableEq E]
    (L : OCEL E O ET OT Q V) {o₁ o₂ : O}
    (h : L.Interacts o₁ o₂) : L.Interacts o₂ o₁ := by
  obtain ⟨e, h₁, h₂⟩ := h
  exact ⟨e, h₂, h₁⟩""" .

procint:Decl_OCEL_interacts_self a procint:Decl ;
  procint:inModule "Ocel.Relations" ;
  procint:declOrder 5 ;
  procint:declName "ProcInt.OCEL.interacts_self" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.OCEL.interacts_self' does not depend on any axioms" ;
  procint:leanCode """/-- Any object appearing in some event's E2O projection interacts with itself. -/
theorem OCEL.interacts_self {E O ET OT Q V : Type} [DecidableEq E]
    (L : OCEL E O ET OT Q V) {o : O} {e : E}
    (h : o ∈ L.objectsOf e) : L.Interacts o o :=
  ⟨e, h, h⟩""" .

procint:Decl_OCEL_e2oProj_length a procint:Decl ;
  procint:inModule "Ocel.Relations" ;
  procint:declOrder 6 ;
  procint:declName "ProcInt.OCEL.e2oProj_length" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.OCEL.e2oProj_length' depends on axioms: [propext]" ;
  procint:leanCode """/-- The qualified projection and the object projection of an event have equal
length: both are maps over the same filtered relation table. -/
theorem OCEL.e2oProj_length {E O ET OT Q V : Type} [DecidableEq E]
    (L : OCEL E O ET OT Q V) (e : E) :
    (L.e2oProj e).length = (L.objectsOf e).length := by
  simp [OCEL.e2oProj, OCEL.objectsOf]""" .

procint:Decl_OCEL_mem_objectsOf a procint:Decl ;
  procint:inModule "Ocel.Relations" ;
  procint:declOrder 7 ;
  procint:declName "ProcInt.OCEL.mem_objectsOf" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.OCEL.mem_objectsOf' depends on axioms: [propext, Quot.sound]" ;
  procint:leanCode """/-- Soundness of the E2O projection: a raw qualified triple (e, q, o) in the
relation table puts o into objectsOf e. -/
theorem OCEL.mem_objectsOf {E O ET OT Q V : Type} [DecidableEq E]
    (L : OCEL E O ET OT Q V) {e : E} {q : Q} {o : O}
    (h : (e, q, o) ∈ L.e2o) : o ∈ L.objectsOf e := by
  unfold OCEL.objectsOf
  exact List.mem_map.mpr ⟨(e, q, o), List.mem_filter.mpr ⟨h, by simp⟩, rfl⟩""" .

# ---------- Module: Ocel.Lifecycle (order 52) ----------

procint:Mod_Ocel_Lifecycle a procint:Module ;
  procint:moduleId "Ocel.Lifecycle" ;
  procint:modPath "Ocel/Lifecycle" ;
  procint:order 52 ;
  procint:moduleDoc "Object lifecycles over OCEL 2.0 logs: the created/active/archived phase lattice with well-formed transition relation (induced by ObjectTypeCardinality created-by/terminated-by event types, wasm4pm-compat src/ocel.rs), and the lifecycle of an object as its events sorted by time — time-orderedness stated as a Pairwise Prop (arXiv 2403.01975)." ;
  procint:importsBlock """import Mathlib
import ProcInt.Ocel.Core""" .

procint:Decl_LifecyclePhase a procint:Decl ;
  procint:inModule "Ocel.Lifecycle" ;
  procint:declOrder 1 ;
  procint:declName "ProcInt.LifecyclePhase" ;
  procint:declKind "inductive" ;
  procint:status "definition" ;
  procint:leanCode """/-- Object lifecycle phase (wasm4pm-compat src/ocel.rs ObjectTypeCardinality:
created-by events open a lifecycle, terminated-by events close it; the phase
lattice is created → active → archived). -/
inductive LifecyclePhase where
  | created
  | active
  | archived
deriving DecidableEq, Repr""" .

procint:Decl_LifecycleStep a procint:Decl ;
  procint:inModule "Ocel.Lifecycle" ;
  procint:declOrder 2 ;
  procint:declName "ProcInt.LifecycleStep" ;
  procint:declKind "inductive" ;
  procint:status "definition" ;
  procint:leanCode """/-- Well-formed lifecycle transitions: an object activates once after creation
and archives once from activity. This is the transition relation induced by the
created-by / terminated-by event types of ObjectTypeCardinality. -/
inductive LifecycleStep : LifecyclePhase → LifecyclePhase → Prop
  | activate : LifecycleStep .created .active
  | archive : LifecycleStep .active .archived""" .

procint:Decl_lifecycleStep_irrefl a procint:Decl ;
  procint:inModule "Ocel.Lifecycle" ;
  procint:declOrder 3 ;
  procint:declName "ProcInt.lifecycleStep_irrefl" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.lifecycleStep_irrefl' does not depend on any axioms" ;
  procint:leanCode """/-- Lifecycle transitions are irreflexive: no phase steps to itself. -/
theorem lifecycleStep_irrefl (p : LifecyclePhase) : ¬ LifecycleStep p p := by
  intro h
  cases h""" .

procint:Decl_archived_terminal a procint:Decl ;
  procint:inModule "Ocel.Lifecycle" ;
  procint:declOrder 4 ;
  procint:declName "ProcInt.archived_terminal" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.archived_terminal' does not depend on any axioms" ;
  procint:leanCode """/-- The archived phase is terminal: no lifecycle step leaves it. -/
theorem archived_terminal (p : LifecyclePhase) : ¬ LifecycleStep .archived p := by
  intro h
  cases h""" .

procint:Decl_OCEL_TimeOrdered a procint:Decl ;
  procint:inModule "Ocel.Lifecycle" ;
  procint:declOrder 5 ;
  procint:declName "ProcInt.OCEL.TimeOrdered" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- A list of events is time-ordered when it is sorted by the OCEL timestamp
map (OCEL 2.0: the lifecycle of an object is its events sorted by time). -/
def OCEL.TimeOrdered {E O ET OT Q V : Type}
    (L : OCEL E O ET OT Q V) (es : List E) : Prop :=
  es.Pairwise (fun a b => L.time a ≤ L.time b)""" .

procint:Decl_OCEL_IsLifecycle a procint:Decl ;
  procint:inModule "Ocel.Lifecycle" ;
  procint:declOrder 6 ;
  procint:declName "ProcInt.OCEL.IsLifecycle" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- es is a lifecycle of object o when it is a permutation of the events of o
that is time-ordered (OCEL 2.0: lifecycle = events of o sorted by time;
wasm4pm-compat src/ocel.rs fn object_attr_timeline is the attribute analog). -/
def OCEL.IsLifecycle {E O ET OT Q V : Type} [DecidableEq O]
    (L : OCEL E O ET OT Q V) (o : O) (es : List E) : Prop :=
  es.Perm (L.eventsOf o) ∧ L.TimeOrdered es""" .

procint:Decl_OCEL_timeOrdered_nil a procint:Decl ;
  procint:inModule "Ocel.Lifecycle" ;
  procint:declOrder 7 ;
  procint:declName "ProcInt.OCEL.timeOrdered_nil" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.OCEL.timeOrdered_nil' does not depend on any axioms" ;
  procint:leanCode """/-- The empty event list is trivially time-ordered. -/
theorem OCEL.timeOrdered_nil {E O ET OT Q V : Type}
    (L : OCEL E O ET OT Q V) : L.TimeOrdered ([] : List E) :=
  List.Pairwise.nil""" .

procint:Decl_OCEL_timeOrdered_singleton a procint:Decl ;
  procint:inModule "Ocel.Lifecycle" ;
  procint:declOrder 8 ;
  procint:declName "ProcInt.OCEL.timeOrdered_singleton" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.OCEL.timeOrdered_singleton' depends on axioms: [propext, Quot.sound]" ;
  procint:leanCode """/-- Any single event is trivially time-ordered. -/
theorem OCEL.timeOrdered_singleton {E O ET OT Q V : Type}
    (L : OCEL E O ET OT Q V) (e : E) : L.TimeOrdered [e] :=
  List.pairwise_singleton (fun a b => L.time a ≤ L.time b) e""" .

# ---------- Module: Ocpq.Query (order 54) ----------

procint:Mod_Ocpq_Query a procint:Module ;
  procint:moduleId "Ocpq.Query" ;
  procint:modPath "Ocpq/Query" ;
  procint:order 54 ;
  procint:moduleDoc "OCPQ predicate ADT (OCPQ Section 4 BASIC_L; wasm4pm-compat src/ocpq.rs enum PredicateKind): E2O and O2O relation predicates plus an anonymous cardinality bound on an event's object projection, with satisfaction against an OCEL log as a Prop and decidable satisfaction under DecidableEq assumptions." ;
  procint:importsBlock """import Mathlib
import ProcInt.Ocel.Core
import ProcInt.Ocel.Relations""" .

procint:Decl_OcpqPredicate a procint:Decl ;
  procint:inModule "Ocpq.Query" ;
  procint:declOrder 1 ;
  procint:declName "ProcInt.OcpqPredicate" ;
  procint:declKind "inductive" ;
  procint:status "definition" ;
  procint:leanCode """/-- OCPQ predicate ADT (wasm4pm-compat src/ocpq.rs enum PredicateKind, OCPQ
Section 4 BASIC_L): an event-to-object relation predicate E2O(e, o, q), an
object-to-object relation predicate O2O(src, q, dst), and an anonymous
cardinality bound on the number of objects of an event, with inclusive
[min, max] window. -/
inductive OcpqPredicate (E O Q : Type) where
  | e2oRel (e : E) (o : O) (q : Q)
  | o2oRel (src : O) (q : Q) (dst : O)
  | cardObjects (e : E) (min max : ℕ)""" .

procint:Decl_OcpqPredicate_Sat a procint:Decl ;
  procint:inModule "Ocpq.Query" ;
  procint:declOrder 2 ;
  procint:declName "ProcInt.OcpqPredicate.Sat" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- Satisfaction of an OCPQ predicate against an OCEL log, as a Prop:
E2O/O2O predicates assert membership of the qualified triple in the log's
relation tables; cardObjects asserts the inclusive count window on the event's
E2O projection (OCPQ Section 4 semantics; wasm4pm-compat src/ocpq.rs). -/
def OcpqPredicate.Sat {E O ET OT Q V : Type} [DecidableEq E]
    (L : OCEL E O ET OT Q V) : OcpqPredicate E O Q → Prop
  | .e2oRel e o q => (e, q, o) ∈ L.e2o
  | .o2oRel s q d => (s, q, d) ∈ L.o2o
  | .cardObjects e mn mx =>
      mn ≤ (L.objectsOf e).length ∧ (L.objectsOf e).length ≤ mx""" .

procint:Decl_OcpqPredicate_instDecidableSat a procint:Decl ;
  procint:inModule "Ocpq.Query" ;
  procint:declOrder 3 ;
  procint:declName "ProcInt.OcpqPredicate.instDecidableSat" ;
  procint:declKind "instance" ;
  procint:status "definition" ;
  procint:leanCode """/-- Satisfaction is decidable when event, object and qualifier types have
decidable equality: relation predicates reduce to decidable list membership,
cardinality predicates to decidable ℕ comparisons. -/
instance OcpqPredicate.instDecidableSat {E O ET OT Q V : Type}
    [DecidableEq E] [DecidableEq O] [DecidableEq Q]
    (L : OCEL E O ET OT Q V) : (p : OcpqPredicate E O Q) → Decidable (p.Sat L)
  | .e2oRel e o q => inferInstanceAs (Decidable ((e, q, o) ∈ L.e2o))
  | .o2oRel s q d => inferInstanceAs (Decidable ((s, q, d) ∈ L.o2o))
  | .cardObjects e mn mx =>
      inferInstanceAs
        (Decidable (mn ≤ (L.objectsOf e).length ∧ (L.objectsOf e).length ≤ mx))""" .

procint:Decl_OcpqPredicate_sat_e2oRel_iff a procint:Decl ;
  procint:inModule "Ocpq.Query" ;
  procint:declOrder 4 ;
  procint:declName "ProcInt.OcpqPredicate.sat_e2oRel_iff" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.OcpqPredicate.sat_e2oRel_iff' does not depend on any axioms" ;
  procint:leanCode """/-- E2O predicate satisfaction is exactly membership of the qualified triple in
the log's E2O table (definitional characterization). -/
theorem OcpqPredicate.sat_e2oRel_iff {E O ET OT Q V : Type} [DecidableEq E]
    (L : OCEL E O ET OT Q V) (e : E) (o : O) (q : Q) :
    (OcpqPredicate.e2oRel e o q).Sat L ↔ (e, q, o) ∈ L.e2o :=
  Iff.rfl""" .

procint:Decl_OcpqPredicate_sat_e2oRel_mem a procint:Decl ;
  procint:inModule "Ocpq.Query" ;
  procint:declOrder 5 ;
  procint:declName "ProcInt.OcpqPredicate.sat_e2oRel_mem" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.OcpqPredicate.sat_e2oRel_mem' depends on axioms: [propext, Quot.sound]" ;
  procint:leanCode """/-- A satisfied E2O predicate certifies the object projection: satisfaction
puts the related object into objectsOf of the related event. -/
theorem OcpqPredicate.sat_e2oRel_mem {E O ET OT Q V : Type} [DecidableEq E]
    (L : OCEL E O ET OT Q V) {e : E} {o : O} {q : Q}
    (h : (OcpqPredicate.e2oRel e o q).Sat L) : o ∈ L.objectsOf e :=
  L.mem_objectsOf h""" .

# ---------- Module: Ocpq.Cardinality (order 55) ----------

procint:Mod_Ocpq_Cardinality a procint:Module ;
  procint:moduleId "Ocpq.Cardinality" ;
  procint:modPath "Ocpq/Cardinality" ;
  procint:order 55 ;
  procint:moduleDoc "OCPQ cardinality bounds: the CardBound structure carrying the min ≤ max well-formedness law as a proof field (port of wasm4pm-compat src/ocpq.rs CardinalityBoundConst, whose law is a const where-bound, and src/ocel.rs ObjectTypeCardinality.admits), with decidable admission, trivial-bound satisfaction at both endpoints, a widening preorder, monotonicity of satisfaction under widening, and the definitional bridge to Ocpq.Query cardObjects satisfaction." ;
  procint:importsBlock """import Mathlib
import ProcInt.Ocel.Core
import ProcInt.Ocpq.Query""" .

procint:Decl_CardBound a procint:Decl ;
  procint:inModule "Ocpq.Cardinality" ;
  procint:declOrder 1 ;
  procint:declName "ProcInt.CardBound" ;
  procint:declKind "structure" ;
  procint:status "definition" ;
  procint:leanCode """/-- An inclusive cardinality bound [min, max] with the well-formedness law
min ≤ max carried as a proof field. Port of wasm4pm-compat src/ocpq.rs
CardinalityBoundConst (where the law is a const where-bound) and of
src/ocel.rs ObjectTypeCardinality's [min_count, max_count] window. -/
structure CardBound where
  min : ℕ
  max : ℕ
  le : min ≤ max""" .

procint:Decl_CardBound_Admits a procint:Decl ;
  procint:inModule "Ocpq.Cardinality" ;
  procint:declOrder 2 ;
  procint:declName "ProcInt.CardBound.Admits" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- A count n satisfies a cardinality bound when it lies in the inclusive
window (wasm4pm-compat src/ocel.rs fn ObjectTypeCardinality.admits). -/
def CardBound.Admits (b : CardBound) (n : ℕ) : Prop :=
  b.min ≤ n ∧ n ≤ b.max""" .

procint:Decl_CardBound_instDecidableAdmits a procint:Decl ;
  procint:inModule "Ocpq.Cardinality" ;
  procint:declOrder 3 ;
  procint:declName "ProcInt.CardBound.instDecidableAdmits" ;
  procint:declKind "instance" ;
  procint:status "definition" ;
  procint:leanCode """/-- Admission is decidable: two ℕ comparisons. -/
instance CardBound.instDecidableAdmits (b : CardBound) (n : ℕ) :
    Decidable (b.Admits n) :=
  inferInstanceAs (Decidable (b.min ≤ n ∧ n ≤ b.max))""" .

procint:Decl_CardBound_admits_min a procint:Decl ;
  procint:inModule "Ocpq.Cardinality" ;
  procint:declOrder 4 ;
  procint:declName "ProcInt.CardBound.admits_min" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.CardBound.admits_min' does not depend on any axioms" ;
  procint:leanCode """/-- Every well-formed bound admits its own lower endpoint (trivial-bound
satisfaction: uses the min ≤ max law). -/
theorem CardBound.admits_min (b : CardBound) : b.Admits b.min :=
  ⟨le_refl b.min, b.le⟩""" .

procint:Decl_CardBound_admits_max a procint:Decl ;
  procint:inModule "Ocpq.Cardinality" ;
  procint:declOrder 5 ;
  procint:declName "ProcInt.CardBound.admits_max" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.CardBound.admits_max' does not depend on any axioms" ;
  procint:leanCode """/-- Every well-formed bound admits its own upper endpoint. -/
theorem CardBound.admits_max (b : CardBound) : b.Admits b.max :=
  ⟨b.le, le_refl b.max⟩""" .

procint:Decl_CardBound_Widens a procint:Decl ;
  procint:inModule "Ocpq.Cardinality" ;
  procint:declOrder 6 ;
  procint:declName "ProcInt.CardBound.Widens" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- Bound widening order: c widens b when c's window contains b's window
(lower endpoint no larger, upper endpoint no smaller). -/
def CardBound.Widens (b c : CardBound) : Prop :=
  c.min ≤ b.min ∧ b.max ≤ c.max""" .

procint:Decl_CardBound_admits_of_widens a procint:Decl ;
  procint:inModule "Ocpq.Cardinality" ;
  procint:declOrder 7 ;
  procint:declName "ProcInt.CardBound.admits_of_widens" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.CardBound.admits_of_widens' does not depend on any axioms" ;
  procint:leanCode """/-- Monotonicity of cardinality satisfaction in bound widening: any count
admitted by a bound is admitted by every widening of it. -/
theorem CardBound.admits_of_widens {b c : CardBound} (h : b.Widens c)
    {n : ℕ} (hn : b.Admits n) : c.Admits n :=
  ⟨le_trans h.1 hn.1, le_trans hn.2 h.2⟩""" .

procint:Decl_CardBound_widens_refl a procint:Decl ;
  procint:inModule "Ocpq.Cardinality" ;
  procint:declOrder 8 ;
  procint:declName "ProcInt.CardBound.widens_refl" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.CardBound.widens_refl' does not depend on any axioms" ;
  procint:leanCode """/-- Widening is reflexive: every bound widens itself. -/
theorem CardBound.widens_refl (b : CardBound) : b.Widens b :=
  ⟨le_refl b.min, le_refl b.max⟩""" .

procint:Decl_CardBound_widens_trans a procint:Decl ;
  procint:inModule "Ocpq.Cardinality" ;
  procint:declOrder 9 ;
  procint:declName "ProcInt.CardBound.widens_trans" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.CardBound.widens_trans' does not depend on any axioms" ;
  procint:leanCode """/-- Widening is transitive, making Widens a preorder on bounds. -/
theorem CardBound.widens_trans {a b c : CardBound}
    (hab : a.Widens b) (hbc : b.Widens c) : a.Widens c :=
  ⟨le_trans hbc.1 hab.1, le_trans hab.2 hbc.2⟩""" .

procint:Decl_CardBound_sat_cardObjects_iff a procint:Decl ;
  procint:inModule "Ocpq.Cardinality" ;
  procint:declOrder 10 ;
  procint:declName "ProcInt.CardBound.sat_cardObjects_iff" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.CardBound.sat_cardObjects_iff' does not depend on any axioms" ;
  procint:leanCode """/-- The OCPQ cardObjects predicate built from a CardBound is satisfied exactly
when the bound admits the length of the event's E2O object projection
(definitional bridge between Ocpq.Query satisfaction and CardBound.Admits). -/
theorem CardBound.sat_cardObjects_iff {E O ET OT Q V : Type} [DecidableEq E]
    (L : OCEL E O ET OT Q V) (e : E) (b : CardBound) :
    (OcpqPredicate.cardObjects (O := O) (Q := Q) e b.min b.max).Sat L ↔
      b.Admits (L.objectsOf e).length :=
  Iff.rfl""" .
@prefix procint: <https://mfact.dev/procint#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ═══════════════════════ Module: Petri.StateEquation (order 24) ═══════════════

procint:Mod_Petri_StateEquation a procint:Module ;
  procint:moduleId "Petri.StateEquation" ;
  procint:modPath "Petri/StateEquation" ;
  procint:order 24 ;
  procint:moduleDoc "Murata 1989 state equation over the integers: markings P →₀ ℕ are cast into ℤ^P via Finsupp.mapRange Int.ofNat, the incidence column of a transition is post − pre, and both the single-step (Mʹ = M + A·eₜ) and firing-sequence (Mʹ = M + Σ A·eₜᵢ) forms of Murata Eq. (5) are proven by pointwise omega and induction on the firing sequence. Ported from the Marking/firing structure in wasm4pm-compat src/petri.rs." ;
  procint:importsBlock """import Mathlib
import ProcInt.Petri.Net
import ProcInt.Petri.Firing
import ProcInt.Petri.Reachability""" .

procint:Decl_Marking_toInt a procint:Decl ;
  procint:inModule "Petri.StateEquation" ;
  procint:declOrder 1 ;
  procint:declName "ProcInt.Marking.toInt" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- Cast a natural-number marking to an integer-valued vector (Murata 1989, Section IV-A:
markings are embedded in ℤ^P so that the state equation lives in an additive group). -/
noncomputable def Marking.toInt {P : Type} (M : Marking P) : P →₀ ℤ :=
  Finsupp.mapRange Int.ofNat rfl M""" .

procint:Decl_Marking_toInt_injective a procint:Decl ;
  procint:inModule "Petri.StateEquation" ;
  procint:declOrder 2 ;
  procint:declName "ProcInt.Marking.toInt_injective" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.Marking.toInt_injective' depends on axioms: [propext, Classical.choice, Quot.sound]" ;
  procint:leanCode """/-- The marking cast is injective: distinct ℕ-markings stay distinct in ℤ^P. -/
theorem Marking.toInt_injective {P : Type} :
    Function.Injective (Marking.toInt (P := P)) :=
  Finsupp.mapRange_injective Int.ofNat rfl (fun _ _ h => Int.ofNat.inj h)""" .

procint:Decl_PetriNet_change a procint:Decl ;
  procint:inModule "Petri.StateEquation" ;
  procint:declOrder 3 ;
  procint:declName "ProcInt.PetriNet.change" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- The incidence column of transition t (Murata 1989, Eq. (4): A = A⁺ − A⁻, one column
per transition): the net token change post t − pre t as an integer vector. -/
noncomputable def PetriNet.change {P T : Type} (N : PetriNet P T) (t : T) : P →₀ ℤ :=
  Finsupp.mapRange Int.ofNat rfl (N.post t) - Finsupp.mapRange Int.ofNat rfl (N.pre t)""" .

procint:Decl_PetriNet_stateEquation_step a procint:Decl ;
  procint:inModule "Petri.StateEquation" ;
  procint:declOrder 4 ;
  procint:declName "ProcInt.PetriNet.stateEquation_step" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.PetriNet.stateEquation_step' depends on axioms: [propext, Classical.choice, Quot.sound]" ;
  procint:leanCode """/-- Murata 1989, state equation (Eq. (5)) for a single firing: if M —t→ M' then
Mʹ = M + A·eₜ over ℤ. -/
theorem PetriNet.stateEquation_step {P T : Type} (N : PetriNet P T)
    {M M' : Marking P} {t : T} (h : N.Step M t M') :
    Marking.toInt M' = Marking.toInt M + N.change t := by
  obtain ⟨hen, rfl⟩ := h
  ext p
  have hp : N.pre t p ≤ M p := hen p
  simp only [Marking.toInt, PetriNet.fire, PetriNet.change, Finsupp.mapRange_apply,
    Finsupp.add_apply, Finsupp.sub_apply, Finsupp.tsub_apply, Int.ofNat_eq_natCast]
  omega""" .

procint:Decl_PetriNet_stateEquation_seq a procint:Decl ;
  procint:inModule "Petri.StateEquation" ;
  procint:declOrder 5 ;
  procint:declName "ProcInt.PetriNet.stateEquation_seq" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.PetriNet.stateEquation_seq' depends on axioms: [propext, Classical.choice, Quot.sound]" ;
  procint:leanCode """/-- Murata 1989, state equation (Eq. (5)) for a firing sequence: the reached marking is the
initial marking plus the sum of incidence columns of the fired transitions, over ℤ.
Proof by induction on the firing sequence. -/
theorem PetriNet.stateEquation_seq {P T : Type} (N : PetriNet P T)
    {M M' : Marking P} {σ : List T} (h : N.FiringSeq M σ M') :
    Marking.toInt M' = Marking.toInt M + (σ.map N.change).sum := by
  induction h with
  | nil => simp
  | cons hstep _ ih =>
      rw [ih, N.stateEquation_step hstep]
      simp [add_assoc]""" .

# ═══════════════════════ Module: Petri.Invariants (order 25) ══════════════════

procint:Mod_Petri_Invariants a procint:Module ;
  procint:moduleId "Petri.Invariants" ;
  procint:modPath "Petri/Invariants" ;
  procint:order 25 ;
  procint:moduleDoc "Murata 1989 Section IV-C place and transition invariants: a P-invariant is a place weighting y with yᵀA = 0, proven conserved along single steps and along the full reachability relation (Murata Theorem 15) by induction on ReflTransGen; a T-invariant is taken in Parikh form over a firing sequence (summed incidence columns vanish) and the reproduction property M' = M (Murata Theorem 16) is proven via injectivity of the ℤ-cast." ;
  procint:importsBlock """import Mathlib
import ProcInt.Petri.Net
import ProcInt.Petri.Firing
import ProcInt.Petri.Reachability
import ProcInt.Petri.StateEquation""" .

procint:Decl_weighSum a procint:Decl ;
  procint:inModule "Petri.Invariants" ;
  procint:declOrder 1 ;
  procint:declName "ProcInt.weighSum" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- Integer pairing ⟪y, v⟫ = Σ_p y(p)·v(p) used to evaluate place weightings against
incidence columns (Murata 1989, Section IV-C). -/
def weighSum {P : Type} (y : P → ℤ) (v : P →₀ ℤ) : ℤ :=
  v.sum fun p n => y p * n""" .

procint:Decl_weighSum_add a procint:Decl ;
  procint:inModule "Petri.Invariants" ;
  procint:declOrder 2 ;
  procint:declName "ProcInt.weighSum_add" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.weighSum_add' depends on axioms: [propext, Classical.choice, Quot.sound]" ;
  procint:leanCode """/-- The pairing ⟪y, ·⟫ is additive in its vector argument. -/
theorem weighSum_add {P : Type} (y : P → ℤ) (v w : P →₀ ℤ) :
    weighSum y (v + w) = weighSum y v + weighSum y w := by
  classical
  unfold weighSum
  exact Finsupp.sum_add_index (fun p _ => mul_zero (y p)) (fun p _ m n => mul_add (y p) m n)""" .

procint:Decl_PetriNet_IsPInvariant a procint:Decl ;
  procint:inModule "Petri.Invariants" ;
  procint:declOrder 3 ;
  procint:declName "ProcInt.PetriNet.IsPInvariant" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- P-invariant (place invariant): a weighting y with yᵀA = 0, i.e. ⟪y, A·eₜ⟫ = 0 for every
transition t (Murata 1989, Section IV-C, Eq. (13)). -/
def PetriNet.IsPInvariant {P T : Type} (N : PetriNet P T) (y : P → ℤ) : Prop :=
  ∀ t, weighSum y (N.change t) = 0""" .

procint:Decl_PetriNet_pInvariant_step a procint:Decl ;
  procint:inModule "Petri.Invariants" ;
  procint:declOrder 4 ;
  procint:declName "ProcInt.PetriNet.pInvariant_step" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.PetriNet.pInvariant_step' depends on axioms: [propext, Classical.choice, Quot.sound]" ;
  procint:leanCode """/-- Conservation along a single step: a P-invariant weighting is unchanged by any firing
(Murata 1989, Theorem 15: yᵀM = yᵀM₀ for reachable M). -/
theorem PetriNet.pInvariant_step {P T : Type} (N : PetriNet P T) {y : P → ℤ}
    (hy : N.IsPInvariant y) {M M' : Marking P} {t : T} (h : N.Step M t M') :
    weighSum y (Marking.toInt M') = weighSum y (Marking.toInt M) := by
  rw [N.stateEquation_step h, weighSum_add, hy t, add_zero]""" .

procint:Decl_PetriNet_pInvariant_reaches a procint:Decl ;
  procint:inModule "Petri.Invariants" ;
  procint:declOrder 5 ;
  procint:declName "ProcInt.PetriNet.pInvariant_reaches" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.PetriNet.pInvariant_reaches' depends on axioms: [propext, Classical.choice, Quot.sound]" ;
  procint:leanCode """/-- Conservation along reachability: a P-invariant weighting is constant on the whole
reachability set (Murata 1989, Theorem 15). Proof by induction on ReflTransGen. -/
theorem PetriNet.pInvariant_reaches {P T : Type} (N : PetriNet P T) {y : P → ℤ}
    (hy : N.IsPInvariant y) {M M' : Marking P} (h : N.Reaches M M') :
    weighSum y (Marking.toInt M') = weighSum y (Marking.toInt M) := by
  induction h with
  | refl => rfl
  | tail _ hstep ih =>
      obtain ⟨t, hstep⟩ := hstep
      rw [N.pInvariant_step hy hstep, ih]""" .

procint:Decl_PetriNet_IsTInvariantSeq a procint:Decl ;
  procint:inModule "Petri.Invariants" ;
  procint:declOrder 6 ;
  procint:declName "ProcInt.PetriNet.IsTInvariantSeq" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- T-invariant (transition invariant) of a firing sequence, taken in Parikh form: the summed
incidence columns of σ vanish, A·⃗σ = 0 (Murata 1989, Section IV-C, Eq. (14)). -/
def PetriNet.IsTInvariantSeq {P T : Type} (N : PetriNet P T) (σ : List T) : Prop :=
  (σ.map N.change).sum = 0""" .

procint:Decl_PetriNet_tInvariant_reproduces a procint:Decl ;
  procint:inModule "Petri.Invariants" ;
  procint:declOrder 7 ;
  procint:declName "ProcInt.PetriNet.tInvariant_reproduces" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.PetriNet.tInvariant_reproduces' depends on axioms: [propext, Classical.choice, Quot.sound]" ;
  procint:leanCode """/-- Murata 1989, Theorem 16 (reproduction): a firing sequence whose Parikh vector is a
T-invariant reproduces the starting marking exactly. Uses injectivity of the ℤ-cast. -/
theorem PetriNet.tInvariant_reproduces {P T : Type} (N : PetriNet P T)
    {M M' : Marking P} {σ : List T} (h : N.FiringSeq M σ M')
    (hσ : N.IsTInvariantSeq σ) : M' = M := by
  apply Marking.toInt_injective
  rw [N.stateEquation_seq h, hσ, add_zero]""" .

# ═══════════════════════ Module: Petri.OCPN (order 26) ════════════════════════

procint:Mod_Petri_OCPN a procint:Module ;
  procint:moduleId "Petri.OCPN" ;
  procint:modPath "Petri/OCPN" ;
  procint:order 26 ;
  procint:moduleDoc "Object-centric Petri nets (van der Aalst and Berti, Fundamenta Informaticae 2020, Def. 5.1-5.3): places typed by object types via pt : P → OT, variable arcs as a predicate on transition-place adjacencies, well-formedness as per-transition type disjointness between variable and non-variable arcs, and colored markings as multisets of (place, object) pairs with a typing conformance predicate proven closed under multiset union and sub-multisets. Ported from ObjectCentricPetriNet in wasm4pm-compat src/petri.rs." ;
  procint:importsBlock """import Mathlib
import ProcInt.Petri.Net""" .

procint:Decl_OCPN a procint:Decl ;
  procint:inModule "Petri.OCPN" ;
  procint:declOrder 1 ;
  procint:declName "ProcInt.OCPN" ;
  procint:declKind "structure" ;
  procint:status "definition" ;
  procint:leanCode """/-- Object-centric Petri net (van der Aalst & Berti 2020, Def. 5.1): a Petri net whose
places are typed by object types via pt : P → OT, and whose transition/place adjacencies
may be marked as variable arcs (Fvar). Ported from ObjectCentricPetriNet in
wasm4pm-compat petri.rs. -/
structure OCPN (P T OT : Type) where
  net : PetriNet P T
  pt : P → OT
  varArc : T → P → Prop""" .

procint:Decl_OCPN_Adjacent a procint:Decl ;
  procint:inModule "Petri.OCPN" ;
  procint:declOrder 2 ;
  procint:declName "ProcInt.OCPN.Adjacent" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- Place p is adjacent to transition t: p occurs in the pre- or post-multiset of t. -/
def OCPN.Adjacent {P T OT : Type} (C : OCPN P T OT) (t : T) (p : P) : Prop :=
  C.net.pre t p ≠ 0 ∨ C.net.post t p ≠ 0""" .

procint:Decl_OCPN_WellFormed a procint:Decl ;
  procint:inModule "Petri.OCPN" ;
  procint:declOrder 3 ;
  procint:declName "ProcInt.OCPN.WellFormed" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- Well-formedness (van der Aalst & Berti 2020, Def. 5.3): at each transition, the object
types consumed through variable arcs and through non-variable arcs are disjoint. -/
def OCPN.WellFormed {P T OT : Type} (C : OCPN P T OT) : Prop :=
  ∀ t p q, C.Adjacent t p → C.Adjacent t q → C.varArc t p → ¬ C.varArc t q →
    C.pt p ≠ C.pt q""" .

procint:Decl_ColoredMarking a procint:Decl ;
  procint:inModule "Petri.OCPN" ;
  procint:declOrder 4 ;
  procint:declName "ProcInt.ColoredMarking" ;
  procint:declKind "abbrev" ;
  procint:status "definition" ;
  procint:leanCode """/-- Colored marking (van der Aalst & Berti 2020, Def. 5.2): a multiset of (place, object)
token pairs. -/
abbrev ColoredMarking (P Obj : Type) := Multiset (P × Obj)""" .

procint:Decl_OCPN_Conforms a procint:Decl ;
  procint:inModule "Petri.OCPN" ;
  procint:declOrder 5 ;
  procint:declName "ProcInt.OCPN.Conforms" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- A colored marking conforms to the typing: every token's object type matches the type of
the place it sits on (van der Aalst & Berti 2020, Def. 5.2, typed token games). -/
def OCPN.Conforms {P T OT Obj : Type} (C : OCPN P T OT) (otyp : Obj → OT)
    (M : ColoredMarking P Obj) : Prop :=
  ∀ pr ∈ M, otyp pr.2 = C.pt pr.1""" .

procint:Decl_OCPN_conforms_add a procint:Decl ;
  procint:inModule "Petri.OCPN" ;
  procint:declOrder 6 ;
  procint:declName "ProcInt.OCPN.conforms_add" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.OCPN.conforms_add' depends on axioms: [propext, Quot.sound]" ;
  procint:leanCode """/-- Conformance is closed under multiset union: adding conforming tokens to a conforming
colored marking stays conforming (needed for the OCPN firing rule, Def. 5.3). -/
theorem OCPN.conforms_add {P T OT Obj : Type} (C : OCPN P T OT) (otyp : Obj → OT)
    {M₁ M₂ : ColoredMarking P Obj}
    (h₁ : C.Conforms otyp M₁) (h₂ : C.Conforms otyp M₂) :
    C.Conforms otyp (M₁ + M₂) := by
  intro pr hpr
  rcases Multiset.mem_add.mp hpr with h | h
  · exact h₁ pr h
  · exact h₂ pr h""" .

procint:Decl_OCPN_conforms_of_le a procint:Decl ;
  procint:inModule "Petri.OCPN" ;
  procint:declOrder 7 ;
  procint:declName "ProcInt.OCPN.conforms_of_le" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.OCPN.conforms_of_le' depends on axioms: [propext, Quot.sound]" ;
  procint:leanCode """/-- Conformance is closed under sub-multisets: consuming tokens preserves conformance
(the token-consumption half of the OCPN firing rule). -/
theorem OCPN.conforms_of_le {P T OT Obj : Type} (C : OCPN P T OT) (otyp : Obj → OT)
    {M₁ M₂ : ColoredMarking P Obj}
    (hle : M₁ ≤ M₂) (h₂ : C.Conforms otyp M₂) : C.Conforms otyp M₁ :=
  fun pr hpr => h₂ pr (Multiset.mem_of_le hle hpr)""" .

# ═══════════════════════ Module: Petri.Stochastic (order 27) ══════════════════

procint:Mod_Petri_Stochastic a procint:Module ;
  procint:moduleId "Petri.Stochastic" ;
  procint:modPath "Petri/Stochastic" ;
  procint:order 27 ;
  procint:moduleDoc "Stochastic Petri nets (Marsan et al. 1984 GSPN; Leemans 2019 stochastic process mining): transitions carry nonnegative rational weights (NNRat, porting the compile-time NUM/DEN fractions of StochasticArcWeight in wasm4pm-compat src/petri.rs) and an immediate/timed kind marker. The stochastic choice over a finite conflict set is weight(t) divided by the total weight; it is proven to be a probability distribution (probabilities sum to 1 and are each at most 1 when the normalizer is nonzero)." ;
  procint:importsBlock """import Mathlib
import ProcInt.Petri.Net""" .

procint:Decl_TransitionKind a procint:Decl ;
  procint:inModule "Petri.Stochastic" ;
  procint:declOrder 1 ;
  procint:declName "ProcInt.TransitionKind" ;
  procint:declKind "inductive" ;
  procint:status "definition" ;
  procint:leanCode """/-- Kind of a stochastic transition: immediate (fires instantly when enabled, weight resolves
conflicts) or timed (fires after a stochastic delay). Ported from ImmediateTransition /
TimedTransition markers in wasm4pm-compat petri.rs; cf. Marsan et al. 1984 GSPN and
Leemans 2019 stochastic process mining. -/
inductive TransitionKind where
  | immediate : TransitionKind
  | timed : TransitionKind
deriving DecidableEq, Repr""" .

procint:Decl_StochasticPetriNet a procint:Decl ;
  procint:inModule "Petri.Stochastic" ;
  procint:declOrder 2 ;
  procint:declName "ProcInt.StochasticPetriNet" ;
  procint:declKind "structure" ;
  procint:status "definition" ;
  procint:leanCode """/-- Stochastic Petri net: a Petri net whose transitions carry nonnegative rational weights
and an immediate/timed kind (Leemans 2019; GSPN of Marsan et al. 1984). Weights in ℚ≥0
port the StochasticArcWeight NUM/DEN ∈ [0,1] compile-time fractions of wasm4pm-compat. -/
structure StochasticPetriNet (P T : Type) where
  net : PetriNet P T
  weight : T → NNRat
  kind : T → TransitionKind""" .

procint:Decl_StochasticPetriNet_choiceWeight a procint:Decl ;
  procint:inModule "Petri.Stochastic" ;
  procint:declOrder 3 ;
  procint:declName "ProcInt.StochasticPetriNet.choiceWeight" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- Total weight of a finite conflict set of transitions (the normalizing constant of the
stochastic choice, Leemans 2019). -/
def StochasticPetriNet.choiceWeight {P T : Type} (S : StochasticPetriNet P T)
    (E : Finset T) : NNRat :=
  E.sum fun t => S.weight t""" .

procint:Decl_StochasticPetriNet_fireProb a procint:Decl ;
  procint:inModule "Petri.Stochastic" ;
  procint:declOrder 4 ;
  procint:declName "ProcInt.StochasticPetriNet.fireProb" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- Probability that transition t wins the stochastic choice among the conflict set E:
weight(t) / Σ over u ∈ E of weight(u) (Leemans 2019 stochastic labelled Petri nets). -/
def StochasticPetriNet.fireProb {P T : Type} (S : StochasticPetriNet P T)
    (E : Finset T) (t : T) : NNRat :=
  S.weight t / S.choiceWeight E""" .

procint:Decl_StochasticPetriNet_fireProb_sum a procint:Decl ;
  procint:inModule "Petri.Stochastic" ;
  procint:declOrder 5 ;
  procint:declName "ProcInt.StochasticPetriNet.fireProb_sum" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.StochasticPetriNet.fireProb_sum' depends on axioms: [propext, Classical.choice, Quot.sound]" ;
  procint:leanCode """/-- The stochastic choice is a probability distribution: over any conflict set with nonzero
total weight, the firing probabilities sum to 1 (Leemans 2019). -/
theorem StochasticPetriNet.fireProb_sum {P T : Type} (S : StochasticPetriNet P T)
    (E : Finset T) (h : S.choiceWeight E ≠ 0) :
    (E.sum fun t => S.fireProb E t) = 1 := by
  unfold StochasticPetriNet.fireProb
  rw [← Finset.sum_div]
  exact div_self h""" .

procint:Decl_StochasticPetriNet_fireProb_le_one a procint:Decl ;
  procint:inModule "Petri.Stochastic" ;
  procint:declOrder 6 ;
  procint:declName "ProcInt.StochasticPetriNet.fireProb_le_one" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.StochasticPetriNet.fireProb_le_one' depends on axioms: [propext, Classical.choice, Quot.sound]" ;
  procint:leanCode """/-- Each firing probability is at most 1: a member's weight never exceeds the conflict set's
total weight (Leemans 2019). -/
theorem StochasticPetriNet.fireProb_le_one {P T : Type} (S : StochasticPetriNet P T)
    (E : Finset T) {t : T} (ht : t ∈ E)
    (h : 0 < S.choiceWeight E) : S.fireProb E t ≤ 1 := by
  rw [StochasticPetriNet.fireProb, div_le_one h]
  exact Finset.single_le_sum (fun i _ => zero_le) ht""" .

# ═══════════════════════ Module: Petri.Unfolding (order 28) ═══════════════════

procint:Mod_Petri_Unfolding a procint:Module ;
  procint:moduleId "Petri.Unfolding" ;
  procint:modPath "Petri/Unfolding" ;
  procint:order 28 ;
  procint:moduleDoc "Petri net unfoldings (Murata 1989 Section VII; Engelfriet 1991 branching processes; McMillan 1992 finite complete prefixes): occurrence nets over condition and event types with a bipartite flow relation on C ⊕ E, causality as its transitive closure, acyclicity and no-backward-conflict axioms, branching processes as labeled occurrence nets, and unfolding prefixes with cut-off event sets. Small lemmas (flow embeds in causality, causality transitive, flow irreflexive by bipartiteness, acyclicity forbids self-flow) are proven; the full unfolding homomorphism condition is stated. Ported from Condition/Event/BranchingProcess/UnfoldingPrefix in wasm4pm-compat src/petri.rs." ;
  procint:importsBlock """import Mathlib
import ProcInt.Petri.Net""" .

procint:Decl_OccurrenceNet a procint:Decl ;
  procint:inModule "Petri.Unfolding" ;
  procint:declOrder 1 ;
  procint:declName "ProcInt.OccurrenceNet" ;
  procint:declKind "structure" ;
  procint:status "definition" ;
  procint:leanCode """/-- Occurrence-net shape underlying a branching process: conditions C (place instances) and
events E (transition occurrences) with pre/post condition sets (Murata 1989 Section VII;
McMillan 1992; Engelfriet 1991 branching processes). Ported from Condition / Event /
BranchingProcess in wasm4pm-compat petri.rs. -/
structure OccurrenceNet (C E : Type) where
  preC : E → Set C
  postC : E → Set C""" .

procint:Decl_OccurrenceNet_Flow a procint:Decl ;
  procint:inModule "Petri.Unfolding" ;
  procint:declOrder 2 ;
  procint:declName "ProcInt.OccurrenceNet.Flow" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- The immediate flow relation on nodes (conditions ⊕ events): condition-to-event via preC,
event-to-condition via postC; never condition-condition or event-event (bipartiteness of
occurrence nets, Murata 1989 Section VII). -/
def OccurrenceNet.Flow {C E : Type} (O : OccurrenceNet C E) :
    (C ⊕ E) → (C ⊕ E) → Prop
  | Sum.inl c, Sum.inr e => c ∈ O.preC e
  | Sum.inr e, Sum.inl c => c ∈ O.postC e
  | _, _ => False""" .

procint:Decl_OccurrenceNet_Causality a procint:Decl ;
  procint:inModule "Petri.Unfolding" ;
  procint:declOrder 3 ;
  procint:declName "ProcInt.OccurrenceNet.Causality" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- Causality: the transitive closure of the flow relation (Engelfriet 1991, the strict
causal order of an occurrence net). -/
def OccurrenceNet.Causality {C E : Type} (O : OccurrenceNet C E) :
    (C ⊕ E) → (C ⊕ E) → Prop :=
  Relation.TransGen O.Flow""" .

procint:Decl_OccurrenceNet_Acyclic a procint:Decl ;
  procint:inModule "Petri.Unfolding" ;
  procint:declOrder 4 ;
  procint:declName "ProcInt.OccurrenceNet.Acyclic" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- The occurrence relation is acyclic: no node causally precedes itself
(Murata 1989 Section VII: occurrence nets are acyclic). -/
def OccurrenceNet.Acyclic {C E : Type} (O : OccurrenceNet C E) : Prop :=
  ∀ n, ¬ O.Causality n n""" .

procint:Decl_OccurrenceNet_NoBackwardConflict a procint:Decl ;
  procint:inModule "Petri.Unfolding" ;
  procint:declOrder 5 ;
  procint:declName "ProcInt.OccurrenceNet.NoBackwardConflict" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- No backward conflict: each condition has at most one producing event (occurrence-net
axiom, Engelfriet 1991 Def. 2.3 / Murata 1989: conditions are unbranched on input). -/
def OccurrenceNet.NoBackwardConflict {C E : Type} (O : OccurrenceNet C E) : Prop :=
  ∀ c e₁ e₂, c ∈ O.postC e₁ → c ∈ O.postC e₂ → e₁ = e₂""" .

procint:Decl_OccurrenceNet_flow_causality a procint:Decl ;
  procint:inModule "Petri.Unfolding" ;
  procint:declOrder 6 ;
  procint:declName "ProcInt.OccurrenceNet.flow_causality" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.OccurrenceNet.flow_causality' depends on axioms: [propext]" ;
  procint:leanCode """/-- Flow embeds in causality (single-step case of the transitive closure). -/
theorem OccurrenceNet.flow_causality {C E : Type} (O : OccurrenceNet C E)
    {a b : C ⊕ E} (h : O.Flow a b) : O.Causality a b :=
  Relation.TransGen.single h""" .

procint:Decl_OccurrenceNet_causality_trans a procint:Decl ;
  procint:inModule "Petri.Unfolding" ;
  procint:declOrder 7 ;
  procint:declName "ProcInt.OccurrenceNet.causality_trans" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.OccurrenceNet.causality_trans' depends on axioms: [propext]" ;
  procint:leanCode """/-- Causality is transitive (transitive closures are transitive; Engelfriet 1991). -/
theorem OccurrenceNet.causality_trans {C E : Type} (O : OccurrenceNet C E)
    {a b c : C ⊕ E} (h₁ : O.Causality a b) (h₂ : O.Causality b c) :
    O.Causality a c :=
  Relation.TransGen.trans h₁ h₂""" .

procint:Decl_OccurrenceNet_flow_irrefl a procint:Decl ;
  procint:inModule "Petri.Unfolding" ;
  procint:declOrder 8 ;
  procint:declName "ProcInt.OccurrenceNet.flow_irrefl" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.OccurrenceNet.flow_irrefl' depends on axioms: [propext]" ;
  procint:leanCode """/-- The flow relation is irreflexive by bipartiteness: no node flows to itself. -/
theorem OccurrenceNet.flow_irrefl {C E : Type} (O : OccurrenceNet C E)
    (n : C ⊕ E) : ¬ O.Flow n n := by
  cases n <;> simp [OccurrenceNet.Flow]""" .

procint:Decl_OccurrenceNet_acyclic_no_self_flow a procint:Decl ;
  procint:inModule "Petri.Unfolding" ;
  procint:declOrder 9 ;
  procint:declName "ProcInt.OccurrenceNet.acyclic_no_self_flow" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.OccurrenceNet.acyclic_no_self_flow' depends on axioms: [propext]" ;
  procint:leanCode """/-- In an acyclic occurrence net there is no self-flow: acyclicity kills causal self-loops
of any length, in particular length one. -/
theorem OccurrenceNet.acyclic_no_self_flow {C E : Type} (O : OccurrenceNet C E)
    (h : O.Acyclic) (n : C ⊕ E) : ¬ O.Flow n n :=
  fun hf => h n (O.flow_causality hf)""" .

procint:Decl_BranchingProcess a procint:Decl ;
  procint:inModule "Petri.Unfolding" ;
  procint:declOrder 10 ;
  procint:declName "ProcInt.BranchingProcess" ;
  procint:declKind "structure" ;
  procint:status "definition" ;
  procint:leanCode """/-- Branching process of a Petri net (Engelfriet 1991; Murata 1989 Section VII): an
occurrence net together with a homomorphism labeling conditions by places and events by
transitions of the original net. Ported from BranchingProcess in wasm4pm-compat petri.rs. -/
structure BranchingProcess (P T C E : Type) where
  occ : OccurrenceNet C E
  condPlace : C → P
  eventTrans : E → T""" .

procint:Decl_UnfoldingPrefix a procint:Decl ;
  procint:inModule "Petri.Unfolding" ;
  procint:declOrder 11 ;
  procint:declName "ProcInt.UnfoldingPrefix" ;
  procint:declKind "structure" ;
  procint:status "definition" ;
  procint:leanCode """/-- Finite complete unfolding prefix (McMillan 1992): a branching process plus a designated
set of cut-off events truncating infinite behavior. Ported from UnfoldingPrefix in
wasm4pm-compat petri.rs. -/
structure UnfoldingPrefix (P T C E : Type) where
  process : BranchingProcess P T C E
  cutoff : Set E""" .

procint:Decl_BranchingProcess_isUnfoldingOf_statement a procint:Decl ;
  procint:inModule "Petri.Unfolding" ;
  procint:declOrder 12 ;
  procint:declName "ProcInt.BranchingProcess.isUnfoldingOf_statement" ;
  procint:declKind "def" ;
  procint:status "stated" ;
  procint:leanCode """/-- Statement (stated, not proven): a branching process is a legal unfolding of net N when
its occurrence net is acyclic, has no backward conflict, and the labeling respects the
pre/post structure of N on singleton arcs (Engelfriet 1991, Def. 3.1 homomorphism condition,
specialized to ordinary nets). -/
def BranchingProcess.isUnfoldingOf_statement {P T C E : Type}
    (B : BranchingProcess P T C E) (N : PetriNet P T) : Prop :=
  B.occ.Acyclic ∧ B.occ.NoBackwardConflict ∧
  (∀ e c, c ∈ B.occ.preC e → N.pre (B.eventTrans e) (B.condPlace c) ≠ 0) ∧
  (∀ e c, c ∈ B.occ.postC e → N.post (B.eventTrans e) (B.condPlace c) ≠ 0)""" .
@prefix procint: <https://mfact.dev/procint#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ═══ Family planning: Planning.Pddl (99) ═══
# Classical STRIPS/PDDL 3.1 planning semantics: ground actions as
# precondition/add/delete triples over a Finset of atoms, iterated
# state-transition application, and sequential plan validity — the
# formal counterpart the registry's `strips`/`gps`/`l2p` breeds and
# `pi:Algo_powl_v2`/`pi:Algo_ocel2` reference-implementation citations
# point at. Citation only, no correspondence claim: this formalizes the
# semantics such a planner implements, not a proof about any specific
# external planner's Rust/Python code (see AGENTS.md STATED discipline).

procint:Mod_Planning_Pddl a procint:Module ;
  procint:moduleId "Planning.Pddl" ;
  procint:modPath "Planning/Pddl" ;
  procint:order 99 ;
  procint:moduleDoc "Classical (STRIPS/PDDL 3.1) planning semantics: ground actions as precondition/add/delete triples over a Finset of atoms, single-step state transition, and fold-based sequential plan validity. Fikes, R. E., & Nilsson, N. J. (1971). STRIPS: A New Approach to the Application of Theorem Proving to Problem Solving. Artificial Intelligence, 2(3-4), 189-208." ;
  procint:importsBlock "import Mathlib" .

procint:Decl_PddlAction a procint:Decl ;
  procint:inModule "Planning.Pddl" ;
  procint:declOrder 1 ;
  procint:declName "ProcInt.PddlAction" ;
  procint:declKind "structure" ;
  procint:status "definition" ;
  procint:leanCode """/-- A ground STRIPS/PDDL action: precondition atoms that must all hold
before firing, plus add/delete effect sets applied to the world state on
execution (Fikes & Nilsson 1971; PDDL 3.1 `:strips` requirement). -/
structure PddlAction (Atom : Type u) where
  pre : Finset Atom
  add : Finset Atom
  del : Finset Atom""" .

procint:Decl_PddlAction_applicable a procint:Decl ;
  procint:inModule "Planning.Pddl" ;
  procint:declOrder 2 ;
  procint:declName "ProcInt.PddlAction.applicable" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- An action is applicable in state `s` iff every precondition atom
already holds. -/
def PddlAction.applicable {Atom : Type u} [DecidableEq Atom]
    (s : Finset Atom) (a : PddlAction Atom) : Prop :=
  a.pre ⊆ s""" .

procint:Decl_PddlAction_apply a procint:Decl ;
  procint:inModule "Planning.Pddl" ;
  procint:declOrder 3 ;
  procint:declName "ProcInt.PddlAction.apply" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- Single-step STRIPS state transition: remove the delete set, then union
in the add set. Does not check applicability — callers combine this with
`PddlAction.applicable` (mirrors `PddlPlan.validCheck` below). -/
def PddlAction.apply {Atom : Type u} [DecidableEq Atom]
    (s : Finset Atom) (a : PddlAction Atom) : Finset Atom :=
  (s \\ a.del) ∪ a.add""" .

procint:Decl_PddlAction_mem_add_mem_apply a procint:Decl ;
  procint:inModule "Planning.Pddl" ;
  procint:declOrder 4 ;
  procint:declName "ProcInt.PddlAction.mem_add_mem_apply" ;
  procint:declKind "theorem" ;
  procint:status "definition" ;
  procint:leanCode """/-- Every atom in an action's add set is present in the resulting state,
matching STRIPS's `add`-effect semantics (Fikes & Nilsson 1971). -/
theorem PddlAction.mem_add_mem_apply {Atom : Type u} [DecidableEq Atom]
    (s : Finset Atom) (a : PddlAction Atom) {x : Atom} (hx : x ∈ a.add) :
    x ∈ PddlAction.apply s a := by
  simp only [PddlAction.apply, Finset.mem_union]
  exact Or.inr hx""" .

procint:Decl_PddlPlan a procint:Decl ;
  procint:inModule "Planning.Pddl" ;
  procint:declOrder 5 ;
  procint:declName "ProcInt.PddlPlan" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- A sequential plan: an ordered list of ground actions (PDDL 3.1
`:strips`-fragment sequential plan, no concurrency). -/
def PddlPlan (Atom : Type u) := List (PddlAction Atom)""" .

procint:Decl_PddlPlan_validCheck a procint:Decl ;
  procint:inModule "Planning.Pddl" ;
  procint:declOrder 6 ;
  procint:declName "ProcInt.PddlPlan.validCheck" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- Boolean-decidable plan-validity check: fold `PddlAction.apply` over
`p` from `s0`, checking applicability at every step, and require the final
state to contain every goal atom. Computable (not noncomputable), so it is
directly `#eval`/`decide`-able — mirrors `ProcInt.fitness`'s
computable-over-`Finsupp`/`Finset` style in `Conformance.TokenReplay`. -/
def PddlPlan.validCheck {Atom : Type u} [DecidableEq Atom]
    (s0 sGoal : Finset Atom) (p : PddlPlan Atom) : Bool :=
  match p with
  | [] => decide (sGoal ⊆ s0)
  | a :: rest =>
      decide (a.pre ⊆ s0) && PddlPlan.validCheck (PddlAction.apply s0 a) sGoal rest""" .

procint:Decl_PddlPlan_valid a procint:Decl ;
  procint:inModule "Planning.Pddl" ;
  procint:declOrder 7 ;
  procint:declName "ProcInt.PddlPlan.valid" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- Prop-valued plan validity: `p` is valid from `s0` reaching `sGoal`
iff `validCheck` returns `true`. Automatically decidable since it unfolds
to `Bool` equality (PDDL 3.1 sequential-plan validity, Ghallab, Nau &
Traverso, Automated Planning: Theory and Practice, 2004, Ch. 2). -/
def PddlPlan.valid {Atom : Type u} [DecidableEq Atom]
    (s0 sGoal : Finset Atom) (p : PddlPlan Atom) : Prop :=
  PddlPlan.validCheck s0 sGoal p = true""" .
