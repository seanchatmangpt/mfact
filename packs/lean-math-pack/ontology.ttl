procint:Mod_Models_CausalNet a procint:Module ;
  procint:moduleId "Models.CausalNet" ;
  procint:modPath "Models/CausalNet" ;
  procint:order 66 ;
  procint:moduleDoc "Causal nets (C-nets): the Heuristics Miner output shape with nodes, dependency arcs scored by a rational dependency measure, and input/output binding obligations, plus the dependency-measure formula and its bounds. Port of wasm4pm-compat causal_net.rs; canonical source: Weijters and Ribeiro, Flexible Heuristics Miner, IEEE CIDM 2011." ;
  procint:importsBlock "import Mathlib" .

procint:Decl_CausalBinding a procint:Decl ;
  procint:inModule "Models.CausalNet" ;
  procint:declOrder 1 ;
  procint:declName "ProcInt.CausalBinding" ;
  procint:declKind "structure" ;
  procint:status "definition" ;
  procint:leanCode """/-- A causal-net binding: which combination of predecessor tasks activates
(or successor tasks is produced by) a task. Port of `causal_net.rs`
`CausalBinding` (Weijters and Ribeiro 2011, FHM C-net bindings). -/
structure CausalBinding (α : Type u) where
  sources : List α
  targets : List α""" .

procint:Decl_CausalNet a procint:Decl ;
  procint:inModule "Models.CausalNet" ;
  procint:declOrder 2 ;
  procint:declName "ProcInt.CausalNet" ;
  procint:declKind "structure" ;
  procint:status "definition" ;
  procint:leanCode """/-- A causal net (Heuristics Miner output shape): nodes, dependency arcs
scored by a rational measure, and input/output binding obligations.
Port of `causal_net.rs` `CausalNet` (Weijters and Ribeiro 2011). -/
structure CausalNet (α : Type u) where
  nodes : List α
  deps : List (α × α × ℚ)
  inputs : List (CausalBinding α)
  outputs : List (CausalBinding α)""" .

procint:Decl_dependencyMeasure a procint:Decl ;
  procint:inModule "Models.CausalNet" ;
  procint:declOrder 3 ;
  procint:declName "ProcInt.dependencyMeasure" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- The Heuristics Miner dependency measure a ⇒ b = (|a>b| − |b>a|) / (|a>b| + |b>a| + 1),
computed in ℚ from directly-follows counts. Weijters and Ribeiro (2011), Section 2;
port of `causal_net.rs` `DependencyMeasure`. -/
def dependencyMeasure (ab ba : ℕ) : ℚ :=
  ((ab : ℚ) - (ba : ℚ)) / ((ab : ℚ) + (ba : ℚ) + 1)""" .

procint:Decl_CausalNet_ScoresValid a procint:Decl ;
  procint:inModule "Models.CausalNet" ;
  procint:declOrder 4 ;
  procint:declName "ProcInt.CausalNet.ScoresValid" ;
  procint:declKind "def" ;
  procint:status "definition" ;
  procint:leanCode """/-- Structural validity of a causal net's scores: every dependency measure
lies in [-1, 1]. Port of `causal_net.rs` `CausalNetRefusal::InvalidDependencyScore`
(the Rust shape stores only nonnegative scores; the signed measure is bounded by 1). -/
def CausalNet.ScoresValid (net : CausalNet α) : Prop :=
  ∀ d ∈ net.deps, -1 ≤ d.2.2 ∧ d.2.2 ≤ 1""" .

procint:Decl_dependencyMeasure_lt_one a procint:Decl ;
  procint:inModule "Models.CausalNet" ;
  procint:declOrder 5 ;
  procint:declName "ProcInt.dependencyMeasure_lt_one" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.dependencyMeasure_lt_one' depends on axioms: [propext, Classical.choice, Quot.sound]" ;
  procint:leanCode """/-- The dependency measure is strictly below 1: the +1 in the denominator
keeps even a one-sided count from reaching certainty
(Weijters and Ribeiro 2011, Section 2). -/
theorem dependencyMeasure_lt_one (ab ba : ℕ) : dependencyMeasure ab ba < 1 := by
  unfold dependencyMeasure
  rw [div_lt_one (by positivity)]
  have hba : (0 : ℚ) ≤ (ba : ℚ) := Nat.cast_nonneg ba
  linarith""" .

procint:Decl_neg_one_lt_dependencyMeasure a procint:Decl ;
  procint:inModule "Models.CausalNet" ;
  procint:declOrder 6 ;
  procint:declName "ProcInt.neg_one_lt_dependencyMeasure" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.neg_one_lt_dependencyMeasure' depends on axioms: [propext, Classical.choice, Quot.sound]" ;
  procint:leanCode """/-- The dependency measure is strictly above -1 (dual bound). -/
theorem neg_one_lt_dependencyMeasure (ab ba : ℕ) : -1 < dependencyMeasure ab ba := by
  unfold dependencyMeasure
  rw [lt_div_iff₀ (by positivity)]
  have hab : (0 : ℚ) ≤ (ab : ℚ) := Nat.cast_nonneg ab
  linarith""" .

procint:Decl_dependencyMeasure_antisymm a procint:Decl ;
  procint:inModule "Models.CausalNet" ;
  procint:declOrder 7 ;
  procint:declName "ProcInt.dependencyMeasure_antisymm" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.dependencyMeasure_antisymm' depends on axioms: [propext, Classical.choice, Quot.sound]" ;
  procint:leanCode """/-- Antisymmetry of the dependency measure: a ⇒ b = −(b ⇒ a)
(Weijters and Ribeiro 2011, Section 2). -/
theorem dependencyMeasure_antisymm (ab ba : ℕ) :
    dependencyMeasure ab ba = - dependencyMeasure ba ab := by
  unfold dependencyMeasure
  rw [← neg_div]
  ring_nf""" .

procint:Decl_dependencyMeasure_self a procint:Decl ;
  procint:inModule "Models.CausalNet" ;
  procint:declOrder 8 ;
  procint:declName "ProcInt.dependencyMeasure_self" ;
  procint:declKind "theorem" ;
  procint:status "proven" ;
  procint:auditMsg "'ProcInt.dependencyMeasure_self' depends on axioms: [propext, Classical.choice, Quot.sound]" ;
  procint:leanCode """/-- Symmetric counts give zero causal strength: a ⇒ a with equal
directly-follows counts in both directions is 0. -/
theorem dependencyMeasure_self (n : ℕ) : dependencyMeasure n n = 0 := by
  unfold dependencyMeasure
  simp""" .

