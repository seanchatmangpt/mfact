@prefix procint: <https://mfact.dev/procint#> .
@prefix verif: <https://mfact.dev/verif#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ── Family: verif (correspondence factory pilot) ────────────────────────────
# Correspondence obligations between a bounded wasm4pm-core implementation
# image and existing procint semantic objects. Target-specific Lean is projected
# by ggen proof patterns; theorem bodies do not live in this declaration graph.
# Aeneas extraction remains a separate observed gate. Status ladder is builder
# derived and never asserted here: DECLARED -> EXTRACTED -> STATED -> PROVEN.

# ═══ D1: token-replay counts ═══

verif:Obl_token_replay_counts_corr a verif:CorrespondenceObligation ;
  verif:corrOrder 1 ;
  verif:corrName "token_replay_counts_corr" ;
  verif:rustSymbol "wasm4pm_core::conformance_counts::ReplayCounts::exact_fitness" ;
  verif:rustFile "wasm4pm-core/src/conformance_counts.rs" ;
  verif:leanDecl "ProcInt.ReplayCounts" ;
  verif:aeneasModule "Wasm4pmVerify.Generated.Wasm4pmCore" ;
  verif:aeneasDecl "ReplayCounts" ;
  verif:proofPattern "ReplayCountsExactFitness" ;
  verif:implementationType "ReplayCounts" ;
  verif:implementationFunction "exactFitness" ;
  verif:carrierName "replayCountsCarrier" ;
  verif:specFunction "ProcInt.fitness" ;
  verif:sourceCommit "96dcfd90a8478cb35f9d6f11f74c2de0e70e5601" ;
  verif:note "D1 total exact token-replay fitness. Rust stores the two rational halves separately so every lawful u64 count tuple is representable without a 129-bit combined denominator. ggen manufactures the Lean implementation model, carrier map, correspondence theorem, bounds theorem, and perfect-replay theorem from this pattern. The generated model is not an Aeneas extraction; scripts/build_verif.py must refuse PROVEN until a real extracted image and matching source hash are observed." .
