# macOS leaves these files everywhere:
.DS_Store
# Created by `lake exe cache get` if no home directory is available
.cache
# `lake` stores its files here:
.lake/
*.olean
# Python bytecode cache directories
**/__pycache__/
*.pyc
# Progress file from scripts/rm_set_option.py
scripts/.rm_set_option_progress.jsonl
# Artifacts from using the devcontainer setup
.devcontainer/devcontainer-lock.json
# Vendored/build directories
/batteries/
/crates/
/target/
/mathlib-temp/
/mathlib_temp/
/release/
/pylab/
/.agents/
/.mfact/
# Scratch/test artifacts
computable.o
test.js
test.wasm
test_collect*.lean

paper/*.aux
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.bbl
paper/*.blg

# Editor swap files (accidentally tracked once — never again)
*.swp
*.swo

# Ephemeral cockpit reports (certified status lives in release/)
.mfact/reports/
release/docs_build.log

# Genetic tactic search: scratch candidate files and run logs (exploratory, off-ledger)
procint/ProcInt/Playground/_scratch_*.lean
.tactic-search/

# Correspondence-factory extraction toolchain (charon/aeneas binaries) — built
# by scripts/verif_build_toolchain.sh from pinned revs, never committed.
# Durable (survives across sessions, unlike /tmp scratchpads) but reproducible
# from source. Lives here, not in wasm4pm-compat, which stays a clean
# source-only publishable crate.
.verif-toolchain/
